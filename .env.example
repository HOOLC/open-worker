# Zork does not use environment variables for product config.
# Start it, then use the desktop client for management.
#
#   cargo run -p zork
#   cargo run -p zork-gui

# Optional developer build storage (not product configuration).
# Paths may be absolute or relative to the repository. No variable expansion.
# Unset: use ./target. Explicit CARGO_TARGET_DIR takes precedence.
# ZORK_BUILD_ROOT=/path/to/build-cache
# Optional mount point: fail instead of writing locally when disconnected.
# ZORK_BUILD_MOUNT=/path/to/mounted-volume
# Soft budget for this root only; explicit cache:prune, not automatic deletion.
# ZORK_BUILD_BUDGET_GIB=100
# ZORK_BUILD_LOW_WATER_GIB=80

# Optional: enable kache executable reuse after verifying local target storage.
# KACHE_CACHE_EXECUTABLES=true
