{
  "name": "zork-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vp dev --host 0.0.0.0",
    "build": "node scripts/prepare-assets.mjs && vp build",
    "check": "vp fmt --check . && vp lint src vite.config.ts && tsc --noEmit",
    "test": "vp test --run",
    "preview": "vp preview --host 0.0.0.0",
    "build:preview": "pnpm build",
    "test:ui": "uv run scripts/check-ui.py"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.3",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.33.0"
}
