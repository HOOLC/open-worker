{
  "providers": [
    {
      "id": "xai",
      "label": "xAI / Grok",
      "billing": [
        {
          "id": "subscription",
          "label": "Grok 订阅",
          "deviceCode": true,
          "template": {
            "baseUrl": "https://cli-chat-proxy.grok.com/v1",
            "models": [
              {
                "id": "grok-4.6",
                "api": "openai-completions",
                "streaming": true,
                "thinking": [
                  "low",
                  "medium",
                  "high",
                  "xhigh"
                ],
                "default_thinking": "xhigh",
                "capabilities": {
                  "input": [
                    "text",
                    "image"
                  ]
                },
                "limits": {
                  "context_window_tokens": 500000,
                  "max_output_tokens": 8192
                },
                "default": true
              }
            ]
          }
        },
        {
          "id": "usage",
          "label": "API 按量",
          "deviceCode": false,
          "template": {
            "baseUrl": "https://api.x.ai/v1",
            "models": [
              {
